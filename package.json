{\n  "name": "osint-eye-desktop",\n  "version": "1.0.0",\n  "description": "Global OSINT Desktop Tool - Electron App",\n  "main": "public/electron.js",\n  "homepage": "./",\n  "scripts": {\n    "dev": "concurrently \"npm run react-dev\" \"npm run electron-dev\"\",\n    "react-dev": "react-scripts start",\n    "react-build": "react-scripts build",\n    "electron-dev": "wait-on http://localhost:3000 && electron .\",\n    "electron-build": "npm run react-build && electron-builder\",\n    "build": "npm run electron-build\",\n    "test": "react-scripts test",\n    "eject": "react-scripts eject"\n  },\n  "dependencies": {\n    "react": "^18.2.0",\n    "react-dom": "^18.2.0",\n    "framer-motion": "^10.16.4",\n    "lucide-react": "^0.292.0",\n    "axios": "^1.6.0"\n  },\n  "devDependencies": {\n    "@types/react": "^18.2.0",\n    "@types/node": "^20.8.0",\n    "typescript": "^5.2.0",\n    "react-scripts": "5.0.1",\n    "electron": "^27.0.0",\n    "electron-builder": "^24.6.4",\n    "concurrently": "^8.2.0",\n    "wait-on": "^7.0.1"\n  },\n  "build": {\n    "appId": "com.osint.eye",\n    "productName": "OSINT Eye",\n    "files": [\n      "build/**/*",\n      "node_modules/**/*",\n      "public/electron.js"\n    ],\n    "directories": {\n      "buildResources": "public"\n    },\n    "win": {\n      "target": [\n        "nsis",\n        "portable"\n      ],\n      "icon": "public/icon.ico"\n    },\n    "nsis": {\n      "oneClick": false,\n      "allowToChangeInstallationDirectory": true\n    }\n  }\n}\n